{
  "manifest_version": 3,
  "name": "Lyris — Lyrics in the light",
  "version": "1.0.0",
  "description": "Apple-inspired synchronized lyrics, word and syllable karaoke, ambient light and Japanese readings for YouTube Music.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Lyris settings",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://music.youtube.com/*",
    "https://lrclib.net/*",
    "https://*.kugou.com/*",
    "http://*.kugou.com/*",
    "https://*.163.com/*",
    "https://*.qq.com/*",
    "https://clients5.google.com/*",
    "https://translate.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "kanji_dict.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
